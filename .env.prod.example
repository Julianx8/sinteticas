# Variables de PRODUCCIÓN. Copiar a .env.prod en el servidor y completar (.env.prod NUNCA se sube a Git).
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Guía completa: docs/despliegue.md

# --- Dominio ---
# Dominio que apunta a la IP del servidor. Caddy obtiene el certificado HTTPS solo.
SITE_ADDRESS=sinteticas.ejemplo.com
# La misma dirección con https:// (enlaces de los correos y CORS)
PUBLIC_URL=https://sinteticas.ejemplo.com
# Correo para los avisos de Let's Encrypt (vencimiento del certificado)
ACME_EMAIL=tu_correo@ejemplo.com

# --- Base de datos ---
POSTGRES_DB=sinteticas_db
POSTGRES_USER=sinteticas
# Generar una propia: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Seguridad ---
# Generar una propia (mínimo 32 caracteres): openssl rand -base64 48
JWT_SECRET=
# Primer super administrador (se crea al arrancar si no existe). Contraseña fuerte y única.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Correo (SMTP real) ---
# Ejemplo con Gmail: activar verificación en 2 pasos y crear una "contraseña de aplicación".
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=Sintéticas <tu_correo@gmail.com>

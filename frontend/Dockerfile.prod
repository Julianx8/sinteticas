# Imagen de producción del frontend: compila con Vite y lo sirve con Caddy (HTTPS automático).
# El Dockerfile normal (npm run dev) sigue siendo el de desarrollo.

# ---------- Etapa de build ----------
FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .
# Vacío = la API está en el mismo dominio (/api/...), detrás de Caddy
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# ---------- Etapa final ----------
FROM caddy:2.8.4-alpine

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 80 443

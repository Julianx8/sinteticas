# Servidor web de producción (docker-compose.prod.yml).
# - Sirve el frontend compilado (dist/) y reenvía /api/* al backend: todo bajo el mismo dominio, sin CORS.
# - Con SITE_ADDRESS = un dominio (sinteticas.ejemplo.com) Caddy obtiene y renueva solo el certificado HTTPS.
# - Con SITE_ADDRESS = :80 sirve por HTTP (pruebas locales y CI).

{
	# Correo para los avisos de Let's Encrypt (certificado HTTPS)
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# Solo tiene efecto en HTTPS: el navegador recuerda usar siempre HTTPS
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API: al backend. Swagger y /actuator no se exponen.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Frontend (PWA)
	handle {
		root * /srv

		# Los archivos de /assets llevan un hash en el nombre: se guardan un año
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# El resto (index.html, sw.js, manifest) se revisa siempre, para que la app se actualice al publicar
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# Rutas de la app (/mis-reservas, /venues/...) → index.html
		try_files {path} /index.html
		file_server
	}
}

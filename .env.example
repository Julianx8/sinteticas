# Copiar este archivo a .env y completar los valores (.env NUNCA se sube a Git)

# --- Base de datos ---
POSTGRES_DB=sinteticas_db
POSTGRES_USER=sinteticas
POSTGRES_PASSWORD=change_me

# --- Backend ---
# Orígenes que pueden llamar a la API (separados por coma)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Clave para firmar los tokens (mínimo 32 caracteres). Generar una propia, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=change_me_con_al_menos_32_caracteres_aleatorios
# Duración del token de acceso y de la sesión (refresh token)
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=14d
# Primer super administrador (se crea al arrancar si no existe)
SUPER_ADMIN_EMAIL=admin@sinteticas.local
SUPER_ADMIN_PASSWORD=change_me_123

# --- Frontend ---
VITE_API_URL=http://localhost:8080
